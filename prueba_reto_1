"""Recorrido secuencial del reto 1."""

from control_drivebase import Base
from deteccion_color import HSV_RANGOS
from pybricks.parameters import Color
from pybricks.tools import wait
import gc
from matriz_2 import ejecutar_matriz_2
from matriz_3 import ejecutar_matriz_3


robot = Base()
print("Voltaje:", robot.Hub.battery.voltage())


# SECCIÓN 1 =====================================================

robot.motor_garra.reset_angle(0)
robot.motor_garra_delantera.reset_angle(0)

robot.giro_de_arco(
    radio_cm=22,
    angulo_deg=90,
    potencia_max=90,
    lado="derecha"
)

gc.collect()

robot.seguir_linea(
    sensor_color=robot.seguidor,
    distancia_cm=79,
    velocidad_max=100,
    lado="derecha",
    tiempo_acomodo_ms=50,
    tiempo_aceleracion_ms=80,
    kp=1.15,
    kd=3.8,
    k_freno=0.05,
    correccion_max=100,
    objetivo_reflexion=27,
    captura_inicial=True,
    tiempo_captura_ms=280,
    potencia_captura=60,
    kp_captura=2.5,
    perfil_salida="encadenado"
)

gc.collect()

robot.girar(angulo_deg=-90, potencia_max=100, perfil="encadenado")

# Torque del código 2
robot.mover_torque(grados_torque=-170, velocidad_torque=600, esperar=False)

robot.avanzar_recto(distancia_cm=-16, velocidad_max=1000, perfil="encadenado")
robot.avanzar_recto(distancia_cm=8.5, velocidad_max=1000, perfil="encadenado")
robot.girar(angulo_deg=70, potencia_max=100, perfil="encadenado")

robot.avanzar_recto(distancia_cm=-32, velocidad_max=1000, perfil="seguro")

robot.avanzar_cruzando_lineas(
    cruces_objetivo=2,
    velocidad=900,
    escape_inicial_cm=8,
    retraso_freno_ms=0
)

gc.collect()

robot.giro_de_arco(
    radio_cm=13,
    angulo_deg=19,
    potencia_max=90,
    lado="derecha"
)


# SECCIÓN 2 =====================================================

robot.seguir_linea(
    sensor_color=robot.seguidor,
    distancia_cm=50,
    velocidad_max=100,
    lado="derecha",
    tiempo_acomodo_ms=50,
    tiempo_aceleracion_ms=80,
    kp=1.15,
    kd=3.8,
    k_freno=0.05,
    correccion_max=100,
    objetivo_reflexion=27,
    captura_inicial=True,
    tiempo_captura_ms=450,
    potencia_captura=35,
    kp_captura=3.5,
    margen_captura=4,
    lecturas_estables_captura=4,
    perfil_salida="encadenado"
)

wait(100)

robot.girar(angulo_deg=-90, potencia_max=85, perfil="encadenado")
robot.avanzar_con_torque(
    distancia_cm=39.5,
    distancia_activacion_torque_cm=17,
    torque_grados=170
)

robot.girar(angulo_deg=90, potencia_max=85, perfil="encadenado")

robot.seguir_linea_hasta_color(
    color_objetivo=Color.GREEN,
    velocidad_max=95,
    lado="derecha"
)

robot.avanzar_recto(distancia_cm=-7, velocidad_max=900, perfil="encadenado")
robot.girar(angulo_deg=-188, potencia_max=90, perfil="encadenado")

# Torque del código 2
robot.mover_torque(grados_torque=-171, velocidad_torque=250, esperar=False)

robot.avanzar_recto(distancia_cm=-22, velocidad_max=900, perfil="encadenado")

robot.seguir_linea_hasta_color(
    color_objetivo=Color.GREEN,
    velocidad_max=95,
    lado="izquierda"
)

robot.girar_corto(6, potencia_max=54, potencia_min=34)
robot.avanzar_recto(14, 700)

matriz_detectada = robot.escanear_matriz()

robot.girar_corto(-6, potencia_max=54, potencia_min=34)

robot.avanzar_recto(distancia_cm=-37.5, velocidad_max=900, perfil="seguro")
robot.girar(angulo_deg=-180, potencia_max=90, perfil="encadenado")

gc.collect()

robot.avanzar_recto(distancia_cm=-19, velocidad_max=900, perfil="encadenado")

# Torque del código 2
robot.mover_torque(grados_torque=170, velocidad_torque=350, esperar=False)

robot.seguir_linea(
    sensor_color=robot.seguidor,
    distancia_cm=48,
    velocidad_max=100,
    lado="derecha",
    tiempo_acomodo_ms=100,
    tiempo_aceleracion_ms=80,
    kp=1.15,
    kd=3.8,
    k_freno=0.05,
    correccion_max=100,
    objetivo_reflexion=27,
    captura_inicial=True,
    tiempo_captura_ms=280,
    potencia_captura=55,
    kp_captura=3.8,
    perfil_salida="encadenado"
)

robot.avanzar_recto(distancia_cm=18.5, velocidad_max=900, perfil="encadenado")
robot.girar(angulo_deg=-90, potencia_max=90, perfil="encadenado")
robot.avanzar_recto(distancia_cm=23, velocidad_max=900, perfil="encadenado")
robot.girar(angulo_deg=-90, potencia_max=80, perfil="encadenado")
robot.avanzar_recto(distancia_cm=15, velocidad_max=900, perfil="encadenado")
robot.girar(angulo_deg=-93.5, potencia_max=80, perfil="encadenado")

wait(100)

robot.avanzar_cruzando_lineas(
    cruces_objetivo=2,
    velocidad=700,
    retraso_freno_ms=90
)

robot.girar(angulo_deg=89, potencia_max=80, perfil="encadenado")

# Igual al código 2 y al código 1
robot.mover_torque(grados_torque=-170, velocidad_torque=250, esperar=False)

robot.avanzar_recto(distancia_cm=-22, velocidad_max=900, perfil="encadenado")

robot.avanzar_recto(distancia_cm=20, velocidad_max=900, perfil="encadenado")
robot.girar(angulo_deg=-38, potencia_max=90, perfil="encadenado")

# GARRAS: exactamente como código 1
robot.mover_garra_delantera(posicion=235, simultaneo=True)
robot.mover_garra_principal(velocidad=1000, grados=200, esperar=True)

robot.avanzar_cruzando_lineas(2, velocidad=500, distancia_extra_cm=13)

robot.mover_garra_principal(
        450,
        esperar=False,
        potencia_apriete=100,
        apretar=True
    )

robot.avanzar_recto(distancia_cm=-2.5, velocidad_max=900, perfil="encadenado")
robot.girar(angulo_deg=36, potencia_max=80, perfil="encadenado")

robot.avanzar_recto(distancia_cm=48, velocidad_max=900)

robot.mover_garra_principal(velocidad=1000, grados=300, esperar=True)

robot.mover_garra_delantera(posicion=0, simultaneo=True)
robot.mover_garra_principal(velocidad=1000, grados=200, esperar=True)

robot.girar(angulo_deg=90, potencia_max=80, perfil="encadenado")

wait(200)

robot.avanzar_hibrido(
    distancia_inicial_cm=4,
    color_objetivo=Color.YELLOW
)

robot.avanzar_recto(distancia_cm=8, velocidad_max=900)

wait(200)

robot.avanzar_recto(distancia_cm=-22.5, velocidad_max=900)
robot.girar(angulo_deg=-92, potencia_max=90, perfil="encadenado")

robot.mover_garra_delantera(posicion=245, simultaneo=True)

robot.avanzar_recto(distancia_cm=-2, velocidad_max=900)

# Torque del código 2: distancia_cm=81
robot.seguir_linea_y_mover_torque(
    sensor_color=robot.seguidor,
    distancia_cm=80,
    velocidad_max=100,
    lado="izquierda",
    tiempo_acomodo_ms=100,
    tiempo_aceleracion_ms=80,
    kp=1.15,
    kd=3.8,
    k_freno=0.05,
    correccion_max=100,
    objetivo_reflexion=27,
    captura_inicial=True,
    tiempo_captura_ms=280,
    potencia_captura=55,
    kp_captura=3.8,
    perfil_salida="encadenado",
    distancia_torque_cm=67,
    grados_torque=170,
    velocidad_torque=450
)

robot.mover_garra_delantera(posicion=0, simultaneo=True)

robot.mover_garra_principal(
    velocidad=300,
    grados=0,
    esperar=True,
    duty_cierre=35
)

gc.collect()


# Si luego vuelves a usar la detección:
print("Matriz detectada:", matriz_detectada)

if matriz_detectada == 2:
     ejecutar_matriz_2(robot)
else:
     ejecutar_matriz_2(robot)
